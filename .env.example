# Server-only. Never prefix with VITE_ or it ships in the client bundle.
ANTHROPIC_API_KEY=sk-ant-...

GOOGLE_CLOUD_PROJECT=chidush-builder
FIRESTORE_DATABASE_ID=chidush-builder-db

# Public Firebase web app config (client). From Firebase console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=chidush-builder.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=chidush-builder
VITE_FIREBASE_APP_ID=

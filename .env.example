# Server-only. Never prefix with VITE_ or it ships in the client bundle.
ANTHROPIC_API_KEY=sk-ant-...

GOOGLE_CLOUD_PROJECT=chidush-builder
FIRESTORE_DATABASE_ID=chidush-builder-db

# Public Firebase web config lives in src/auth/firebaseConfig.ts. Set VITE_FIREBASE_*
# here only to point local dev at a different Firebase project.
